# Application Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=

# Authentication Configuration (Session / JWT signing secret)
AUTH_SECRET=

# AI & Market Data Adapter (Advisory price recommendations - e.g. Gemini, OpenAI, or market data feeds)
AI_API_KEY=
MARKET_DATA_API_KEY=

# Payment Gateway Adapter (External provider credentials - e.g. Razorpay, Stripe)
# Note: Orders and payments are server-verified; never expose these keys to the client.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Object Storage Adapter (S3-compatible storage for produce and profile images)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

